# Nginx configuration for Dispatcharr
# Copy to /usr/local/etc/nginx/dispatcharr.conf and include in nginx.conf
#
# Example nginx.conf addition:
#   include /usr/local/etc/nginx/dispatcharr.conf;

upstream dispatcharr_wsgi {
    server unix:%%DISPATCHARR_RUNDIR%%/dispatcharr.sock fail_timeout=0;
}

upstream dispatcharr_asgi {
    server 127.0.0.1:8001 fail_timeout=0;
}

server {
    listen 9191;
    server_name _;

    client_max_body_size 100M;

    # Static files
    location /static/ {
        alias %%DISPATCHARR_DIR%%/static/;
        expires 30d;
        add_header Cache-Control "public, immutable";
    }

    # Frontend assets
    location /assets/ {
        alias %%DISPATCHARR_DIR%%/frontend/dist/assets/;
        expires 30d;
        add_header Cache-Control "public, immutable";
    }

    # Media files
    location /media/ {
        alias %%DISPATCHARR_DIR%%/media/;
    }

    # Logos
    location /logos/ {
        alias %%DISPATCHARR_DATADIR%%/logos/;
        expires 24h;
        add_header Cache-Control "public";
    }

    # WebSocket connections
    location /ws/ {
        proxy_pass http://dispatcharr_asgi;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 86400;
    }

    # API and main application
    location / {
        proxy_pass http://dispatcharr_wsgi;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 300;
        proxy_send_timeout 300;
        proxy_read_timeout 300;
    }
}
